// Prisma-Schema — Stufe 2 (Datenbank-Fundament).
// Die Modelle spiegeln 1:1 die Typen aus types/index.ts, damit die
// Content-Fassade (lib/content.ts) ohne Änderung an den Aufrufern von den
// statischen Arrays auf Prisma umgestellt werden konnte.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gericht {
  id             String   @id @default(cuid())
  name           String
  beschreibung   String?
  preis          Float
  kategorie      String // z. B. "Vorspeise", "Hauptgang", "Snack", "Dessert", "Getränk"
  bereich        String // "restaurant" | "imbiss"
  verfuegbar     Boolean  @default(true)
  bild           String?
  reihenfolge    Int      @default(0)
  // Kennzeichnungspflichtige Angaben (LMIV) — sprachneutrale Codes, z. B.
  // ["glutenhaltiges_getreide", "milch"] bzw. ["farbstoff"]. Labels/Legende
  // kommen aus lib/schemas.ts + den Wörterbüchern (i18n-neutral).
  allergene      String[] @default([])
  zusatzstoffe   String[] @default([])
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([bereich, verfuegbar])
}

model Event {
  id             String   @id @default(cuid())
  slug           String   @unique
  titel          String
  beschreibung   String?
  datum          DateTime
  uhrzeit        String // z. B. "20:00 Uhr"
  eintritt       String? // z. B. "8,00 €" oder "Eintritt frei"
  bild           String?
  veroeffentlicht Boolean  @default(false)
  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([veroeffentlicht, datum])
}

model Bild {
  id           String   @id @default(cuid())
  url          String
  alt          String?
  beschreibung String?
  bereich      String // "restaurant" | "kotten" | "imbiss" | "aussen" | "essen" | "events"
  reihenfolge  Int      @default(0)
  erstelltAm   DateTime @default(now())

  @@index([bereich])
}

model Einstellung {
  key   String @id
  value String
}

// Übersetzungen der redaktionellen Inhalte (EN/NL). Bewusst generisch statt je
// Modell eigener Spalten: eine Tabelle bedient Gerichte, Kategorienamen, Events,
// Bildtexte und Einstellungen — und ein neues übersetzbares Feld braucht keine
// Migration mehr.
//
// Deutsch ist die Pflegesprache und steht weiterhin am Datensatz selbst; hier
// liegen ausschließlich die Abweichungen. Fehlt eine Zeile (oder ist sie leer),
// fällt die Website auf Deutsch zurück — dieselbe Logik wie beim Deep-Merge der
// Wörterbücher in lib/i18n/dictionary.ts.
//
// `datensatzId` ist die cuid des übersetzten Datensatzes. Ausnahmen: bei
// `modell = "kategorie"` der deutsche Kategoriename (Kategorien sind keine
// eigene Tabelle) und bei `modell = "einstellung"` der Einstellungs-Key.
model Uebersetzung {
  id             String   @id @default(cuid())
  modell         String // "gericht" | "kategorie" | "event" | "bild" | "einstellung"
  datensatzId    String
  locale         String // "en" | "nl"
  feld           String // "name" | "beschreibung" | "titel" | …
  wert           String
  aktualisiertAm DateTime @updatedAt

  @@unique([modell, datensatzId, locale, feld])
  @@index([modell, locale])
}

// Admin-Benutzer (i.d.R. genau einer: der Betreiber). Passwort wird als
// bcrypt-Hash gespeichert; der erste Benutzer wird per Seed aus ADMIN_EMAIL /
// ADMIN_PASSWORD angelegt.
model Benutzer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwortHash String
  name         String?
  rolle        String   @default("admin")
  erstelltAm   DateTime @default(now())
}

// Flyer — einseitige A4-Blätter zum Ausdrucken: das Vorwort als Einlage in die
// gedruckte Speisekarte, aktuelle Aktionen, Neuigkeiten, Event-Ankündigungen.
//
// Warum eine eigene Tabelle und nicht Einstellungen: ein Flyer ist kein
// Dauertext, sondern entsteht mehrfach (Saison, Aktion, Feiertag). Gespeichert
// bleibt er als Vorlage — beim nächsten Mal wird er dupliziert und angepasst,
// statt neu getippt.
//
// Bewusst OHNE Layout-/Stilfelder: Kopf (Emblem + Schriftzug) und Abschlussblock
// (Kontakt + Kanäle) sind unveränderlich und kommen aus derselben Druck-Mechanik
// wie die Speisekarte (components/admin/druck.tsx). Der Flyer hält nur Inhalt —
// dadurch bleiben Karte und Beiblatt automatisch im selben Stil.
model Flyer {
  id           String  @id @default(cuid())
  // Interne Bezeichnung für die Verwaltungsliste ("Vorwort Karte 2026").
  // Steht NICHT auf dem gedruckten Blatt.
  titel        String
  ueberschrift String // gedruckte Überschrift, z. B. "Herzlich willkommen"
  unterzeile   String? // kleine Zeile unter der Überschrift
  vorwort      String? // Fließtext; Absätze durch Leerzeile getrennt
  grussformel  String? // z. B. "Ihre Familie Çalışkan"
  bild         String? // ein großes Bild unter dem Vorwort (z. B. Event-Foto)

  // Bausteine, die sich aus bereits gepflegten Daten füllen — nichts davon wird
  // im Flyer doppelt erfasst.
  mitEvents          Boolean @default(false) // kommende Events aus der DB
  mitOeffnungszeiten Boolean @default(false) // aus den Einstellungen

  // Zeitraum der Aktionen — dient der Übersicht in der Verwaltung und wird,
  // wenn gesetzt, als Gültigkeitshinweis mitgedruckt.
  gueltigVon DateTime?
  gueltigBis DateTime?

  // Heute rein informativ (der Flyer ist Druck-Erzeugnis). Vorbereitet für eine
  // spätere News-Sektion auf der Website — dann ohne weitere Migration.
  veroeffentlicht Boolean @default(false)

  aktionen       FlyerAktion[]
  erstelltAm     DateTime      @default(now())
  aktualisiertAm DateTime      @updatedAt
}

// Ein Aktions-/Hinweisblock auf einem Flyer ("Mittagstisch", "Schlager-Nacht").
// Eigene Zeilen statt eines JSON-Felds: sortierbar, einzeln übersetzbar über die
// generische Uebersetzung-Tabelle und in der Verwaltung wie gewohnt editierbar.
model FlyerAktion {
  id          String  @id @default(cuid())
  flyerId     String
  flyer       Flyer   @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  titel       String
  text        String?
  hinweis     String? // Zeitraum/Preis, z. B. "Di–Fr 11:30–14:00 · 9,90 €"
  bild        String? // kleines Foto neben dem Text
  reihenfolge Int     @default(0)

  @@index([flyerId, reihenfolge])
}
